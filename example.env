# =============================================================
# AmazonHelp AI Support Agent — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values:
#   cp example.env .env
# =============================================================

# --- Gemini API (Free Tier) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Alternatively: OpenAI API (Paid) ---
# Uncomment and set these to use OpenAI instead:
# OPENAI_API_KEY=sk-your-openai-api-key-here
# API_BASE_URL=https://api.openai.com/v1

# --- Model Selection ---
# For Gemini (free):
PIPELINE_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite

# For OpenAI (paid):
# PIPELINE_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o

# --- Embedding ---
# "local" = sentence-transformers/all-MiniLM-L6-v2 (free, no API key needed)
EMBEDDING_PROVIDER=local

# --- Data Paths ---
RAW_DATA_PATH=data/raw/twcs.csv
PROCESSED_DATA_PATH=data/processed/amazon_threads.json
GOLDEN_SET_PATH=data/golden/golden_set.json

# --- RAG Settings ---
CHROMA_DB_PATH=data/chroma
RETRIEVER_TOP_K=5
